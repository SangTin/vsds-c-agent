# Exclude the local knowledge base EXCEPT the baked indexes (needed by Dockerfile.v6 / Dockerfile.v10).
data_kb/*
!data_kb/legal/
!data_kb/polysci/
data_kb/legal/*
!data_kb/legal/index.faiss
!data_kb/legal/metadata.jsonl
data_kb/polysci/*
!data_kb/polysci/index.faiss
!data_kb/polysci/metadata.jsonl
docs/
output/
results/
sample_data/
tests/

# Keep the submission GGUF copyable while excluding other local weights.
models/*
!models/qwen3.5-9b/
models/qwen3.5-9b/*
!models/qwen3.5-9b/*.gguf
